    ['URL Rule Version', V3_CONFIG.URL_RULE_VERSION],

    ['Project ID', project.projectId],
    ['Project Name', project.projectName || ''],
    ['Project Keyword', project.projectKeyword || project.projectName || ''],
    ['Project Type', project.projectType || ''],
    ['Provisioning Mode', project.provisioningMode || ''],
    ['Project Structure Version', project.projectStructure && project.projectStructure.version || '4.1.0'],
    ['Project Structure Mode', project.projectStructure && project.projectStructure.mode || 'PROJECT_CENTRIC'],
    ['Structure Migration Policy', project.projectStructure && project.projectStructure.migrationPolicy || 'PRESERVE_LEGACY_NO_AUTO_MIGRATION'],
    ['Target Page URL', project.targetPageUrl || ''],

    // Project Settings & Branding V4.6.3: one-to-one operational projection.
    ['Brand Name', branding.brandName || project.brandName || ''],
    ['Website URL', branding.websiteUrl || project.websiteUrl || ''],
    ['Branding Enabled', projectConfigBoolV463_(branding.enabled !== false)],
    ['Branding Schema Version', branding.schemaVersion || ''],
    ['Hotline 1', phones[0] || project.phone || ''],
    ['Hotline 2', phones[1] || project.phone2 || ''],
    ['Branding Phones', phones.length ? phones.join(' | ') : [project.phone, project.phone2].filter(Boolean).join(' | ')],
    ['Branding Email', branding.email || project.email || ''],
    ['Branding Address', branding.address || project.address || ''],

    ['Logo Enabled', projectConfigBoolV463_(logo.enabled !== false)],
    ['Logo Drive File ID', logo.driveFileId || project.logoFileId || ''],
    ['Logo Public URL', logo.publicUrl || ''],

    // CTA Footer is optional in V4.6.3. Empty values are valid persisted state.
    ['CTA Enabled', projectConfigBoolV463_(cta.enabled !== false)],
    ['CTA Drive File ID', cta.driveFileId || ''],
    ['CTA Public URL', cta.publicUrl || ''],
    ['CTA Label', cta.label || 'TƯ VẤN NGAY'],

    ['Google Maps URL', project.googleMapsUrl || ''],

    ['Branding Target Slides', projectConfigBoolV463_(targets.slides !== false)],
    ['Branding Target Docs', projectConfigBoolV463_(targets.docs !== false)],
    ['Branding Target PDF', projectConfigBoolV463_(targets.pdf !== false)],
    ['Branding Target DOCX', projectConfigBoolV463_(targets.docx !== false)],
    ['Branding Target HTML', projectConfigBoolV463_(targets.html !== false)],

    ['Scheduled Registry Sync', projectConfigBoolV463_(!!scheduler.enabled)],
    ['Quick Scan Interval Minutes', scheduler.quickScanIntervalMinutes == null ? '' : String(scheduler.quickScanIntervalMinutes)],
    ['Full Reconcile Interval Hours', scheduler.fullReconcileIntervalHours == null ? '' : String(scheduler.fullReconcileIntervalHours)],
    ['Last Quick Scan At', scheduler.lastQuickScanAt || ''],
    ['Last Full Reconcile At', scheduler.lastFullReconcileAt || ''],

    ['Root Folder ID', project.rootFolderId],
    ['Articles Folder ID', project.folders.articlesFolderId || ''],
    ['DOCX Folder ID', project.folders.docxFolderId || ''],
    ['HTML Folder ID', project.folders.htmlFolderId || ''],
    ['Slides Folder ID', project.folders.slidesFolderId || ''],
    ['PDF Folder ID', project.folders.pdfFolderId || ''],
    ['Photos Folder ID', project.folders.photosFolderId || ''],
    ['Videos Folder ID', project.folders.videosFolderId || ''],
    ['Podcasts Folder ID', project.folders.podcastsFolderId || ''],
    ['Legacy Sheets Folder ID', project.folders.sheetsFolderId || ''],
    ['Legacy Forms Folder ID', project.folders.formsFolderId || ''],

    ['Private Storage Version', project.privateStorage && project.privateStorage.version || ''],
    ['Private Storage Status', project.privateStorage && project.privateStorage.status || 'NOT_CONFIGURED'],
    ['Private System Root Folder ID', project.privateStorage && project.privateStorage.rootFolderId || ''],
    ['Private Projects Folder ID', project.privateStorage && project.privateStorage.projectsFolderId || ''],
    ['Private Project Folder ID', project.privateStorage && project.privateStorage.projectFolderId || ''],
    ['Private Legacy Archive Folder ID', project.privateStorage && project.privateStorage.legacyArchiveFolderId || ''],
    ['Private Entity Data Archive Folder ID', project.privateStorage && project.privateStorage.entityDataArchiveFolderId || ''],
    ['Private Forms Archive Folder ID', project.privateStorage && project.privateStorage.formsArchiveFolderId || ''],
    ['Registry Private', projectConfigBoolV463_(!!(project.privateStorage && project.privateStorage.registryPrivate))],
    ['Legacy Entity Retirement Status', project.privateStorage && project.privateStorage.entityRetirement && project.privateStorage.entityRetirement.status || 'NOT_STARTED'],
    ['Legacy Runtime Scan Disabled', projectConfigBoolV463_(!!(project.privateStorage && project.privateStorage.entityRetirement && project.privateStorage.entityRetirement.runtimeScanDisabled))],

