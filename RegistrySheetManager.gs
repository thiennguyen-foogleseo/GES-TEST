/** Human-readable per-project registry spreadsheet. */

const V3_ASSET_HEADERS = [
  'Key','Project ID','Project Name','Source Doc ID','Source Doc Name','Asset Type','Asset ID','Asset Name','MIME Type',
  'Folder ID','Folder Name','Drive/Public URL','Source Modified','Asset Modified','Sync Status','Lifecycle Status',
  'Resolution Method','System Asset','First Seen','Last Seen','Last Synced','Last Seen Run ID','Notes'
];

const V3_URL_HEADERS = [
  'Key','Project ID','Source Doc ID','Asset Type','Asset ID','Asset Name','Variant Type','Anchor/Name','URL','URL Status',
  'Published ID','Generated By','Last Verified','QR','Hyperlink','Date','TinyURL','CleanURI','Spoo.me','Notes'
];

const V3_LOG_HEADERS = ['Timestamp','Project ID','Action','Source Doc','Asset Type','Asset ID','Result','Message','Details'];

const V45_ENTITY_CONFIG_HEADERS = ['Property','Value','Source','Last Synced'];
const V45_ENTITY_INDEX_HEADERS = [
  'Key','Project ID','Source Doc ID','Source Doc Name','Legacy Entity Sheet ID','Legacy Entity Sheet Name',
  'Content Fingerprint','Entity Fingerprint','Generated By','Source Doc URL','Resolution Method','Legacy Folder ID',
  'Lifecycle','Archived At','Last Verified','Notes'
];

function ensureRegistrySpreadsheet_(project) {
  if (project.registrySheetId) {
    try {
      const ss = SpreadsheetApp.openById(project.registrySheetId);
      initializeRegistrySheets_(ss, project);
      return ss;
    } catch (e) {
      project.registrySheetId = '';
    }
  }

  const publicRoot = getProjectRoot_(project);
  const privateParent = typeof getRegistryParentFolderV45_ === 'function' ? getRegistryParentFolderV45_(project) : null;
  const targetParent = privateParent || publicRoot;
  const expectedName = project.rootFolderName + ' Asset Registry';
  const candidates = [];

  function collect(folder) {
    if (!folder) return;
    const it = folder.getFilesByName(expectedName);
    while (it.hasNext()) {
      const f = it.next();
      if (f.getMimeType() === V3_CONFIG.MIME.GOOGLE_SHEETS) candidates.push(f);
    }
  }

  // V4.5 prefers the private project folder. Public root is checked only as
  // backward-compatible discovery for projects not migrated yet.
  collect(privateParent);
  if (!candidates.length) collect(publicRoot);
  if (candidates.length > 1) throw new Error('Có nhiều Registry Sheet trùng tên: ' + expectedName);

  let ss;
  if (candidates.length === 1) {
    ss = SpreadsheetApp.openById(candidates[0].getId());
  } else {
    ss = SpreadsheetApp.create(expectedName);
    DriveApp.getFileById(ss.getId()).moveTo(targetParent);
  }
  project.registrySheetId = ss.getId();
  initializeRegistrySheets_(ss, project);
  saveProject_(project);
  syncProjectConfigSheet_(project);
  return ss;
}

function initializeRegistrySheets_(ss, project) {
  ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.ASSETS, V3_ASSET_HEADERS);
  ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.URLS, V3_URL_HEADERS);
  ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.CONFIG, ['Key','Value']);
  ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.LOG, V3_LOG_HEADERS);
  if (V3_CONFIG.REGISTRY_TABS.EXTENDED_ASSETS && typeof GES_EXTENDED_GOOGLE_ASSETS_V465 !== 'undefined') {
    ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.EXTENDED_ASSETS, GES_EXTENDED_GOOGLE_ASSETS_V465.HEADERS);
  }
  var privateState = project && typeof normalizePrivateStorageStateV45_ === 'function'
    ? normalizePrivateStorageStateV45_(project.privateStorage)
    : null;
  var privateReady = !!(privateState && privateState.status && privateState.status !== 'NOT_CONFIGURED');
  if (privateReady && V3_CONFIG.REGISTRY_TABS.ENTITY_CONFIG) ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.ENTITY_CONFIG, V45_ENTITY_CONFIG_HEADERS);
  if (privateReady && V3_CONFIG.REGISTRY_TABS.ENTITY_INDEX) ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.ENTITY_INDEX, V45_ENTITY_INDEX_HEADERS);
  const defaultSheet = ss.getSheetByName('Sheet1');
  if (defaultSheet && ss.getSheets().length > 1 && defaultSheet.getLastRow() <= 1 && defaultSheet.getLastColumn() <= 1) {
    try { ss.deleteSheet(defaultSheet); } catch (ignore) {}
  }
}

function ensureSheetWithHeaders_(ss, name, headers) {
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  const current = sh.getLastColumn() >= headers.length ? sh.getRange(1,1,1,headers.length).getValues()[0] : [];
  const mismatch = headers.some(function(h, i) { return current[i] !== h; });
  if (mismatch) sh.getRange(1,1,1,headers.length).setValues([headers]);
  sh.setFrozenRows(1);
  return sh;
}

function projectConfigBoolV463_(value) {
  return value ? 'TRUE' : 'FALSE';
}

