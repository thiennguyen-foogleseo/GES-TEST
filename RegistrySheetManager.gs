  const insertAtV465 = rows.findIndex(function(r) { return r[0] === 'Branding Target Slides'; });
  if (insertAtV465 >= 0 && extendedRowsV465.length) {
    Array.prototype.splice.apply(rows, [insertAtV465, 0].concat(extendedRowsV465));
