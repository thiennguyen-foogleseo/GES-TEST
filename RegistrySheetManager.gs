  });
}

function upsertInventoryAsset_(project, asset) {
  const ss = ensureRegistrySpreadsheet_(project);
  const sh = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.ASSETS);
  const key = assetSheetKey_(project.projectId, asset.sourceDocId || '', asset.assetType, asset.assetId);
  const rowMap = buildKeyRowMap_(sh);
  const existingRow = rowMap[key] || 0;
  const now = nowIso_();
  const firstSeen = existingRow ? sh.getRange(existingRow, 19).getValue() : now;
  const values = [
    key, project.projectId, project.brandName || project.rootFolderName,
    asset.sourceDocId || '', asset.sourceDocName || '', asset.assetType || '', asset.assetId || '', asset.assetName || '', asset.mimeType || '',
    asset.folderId || '', asset.folderName || '', asset.url || '', asset.sourceModified || '', asset.assetModified || '', asset.syncStatus || '', asset.lifecycleStatus || 'KNOWN',
    asset.resolutionMethod || '', asset.systemAsset ? 'TRUE' : 'FALSE', firstSeen || now, now, asset.lastSynced || '', asset.lastSeenRunId || '', asset.notes || ''
  ];
  if (existingRow) sh.getRange(existingRow,1,1,V3_ASSET_HEADERS.length).setValues([values]);
  else sh.appendRow(values);

  const variants = generateUrlVariantsForAsset_(project, asset);
  upsertUrlVariants_(project, asset, variants);
  return key;
}

function buildKeyRowMap_(sheet) {
  const out = {};
  const last = sheet.getLastRow();
  if (last < 2) return out;
  const keys = sheet.getRange(2,1,last-1,1).getValues();
  keys.forEach(function(row, i) { if (row[0]) out[String(row[0])] = i + 2; });
  return out;
}

function upsertUrlVariants_(project, asset, variants) {
  const ss = ensureRegistrySpreadsheet_(project);
  const sh = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.URLS);
  const rowMap = buildKeyRowMap_(sh);
  const date = Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd');
  (variants || []).forEach(function(v) {
    const key = [project.projectId, asset.assetType, asset.assetId, v.variantType].join('|');
    const existingRow = rowMap[key] || 0;
    let preservedQr = '';
    let preservedTinyUrl = '';
    let preservedCleanUri = '';
    let preservedSpooMe = '';

    // URL enrichment is keyed to the long URL. Preserve it only when the URL
    // for this Registry key has not changed; otherwise stale short URLs must be
    // cleared and regenerated by V4.6.4.
    if (existingRow) {
      try {
        const existing = sh.getRange(existingRow, 1, 1, V3_URL_HEADERS.length).getDisplayValues()[0];
        const sameUrl = normalizeUrl_(existing[8] || '') === normalizeUrl_(v.url || '');
        if (sameUrl) {
          preservedQr = existing[13] || '';
          preservedTinyUrl = existing[16] || '';
          preservedCleanUri = existing[17] || '';
          preservedSpooMe = existing[18] || '';
        }
      } catch (ignore) {}
    }

    const row = [
      key, project.projectId, asset.sourceDocId || '', asset.assetType, asset.assetId, asset.assetName || '',
      v.variantType, v.label || asset.assetName || '', v.url || '', v.status || '', v.publishedId || '', v.generatedBy || 'V3', nowIso_(),
      preservedQr, v.url ? '=HYPERLINK("' + String(v.url).replace(/"/g,'""') + '","' + String(v.label || asset.assetName || v.variantType).replace(/"/g,'""') + '")' : '',
      date, preservedTinyUrl, preservedCleanUri, preservedSpooMe, v.notes || ''
    ];
    if (existingRow) sh.getRange(existingRow,1,1,V3_URL_HEADERS.length).setValues([row]);
    else sh.appendRow(row);
  });
}

function appendRegistryLog_(projectId, entry) {
  if (!projectId) return;
  const project = getProject_(projectId);
  if (!project || !project.registrySheetId) return;
  const ss = SpreadsheetApp.openById(project.registrySheetId);
  const sh = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.LOG);
  const p = entry.payload || {};
  const details = Object.assign({
    projectType: project.projectType || '',
    provisioningMode: project.provisioningMode || ''
  }, p);
  sh.appendRow([
    entry.timestamp || nowIso_(), projectId, entry.action || '', p.docName || '', p.assetType || '', p.assetId || '', p.result || '', p.message || '', JSON.stringify(details)
  ]);
}

function getDirectParentId_(file) {
  const it = file.getParents();
  return it.hasNext() ? it.next().getId() : '';
}

function getDirectParentName_(file) {
  const it = file.getParents();
  return it.hasNext() ? it.next().getName() : '';
}

function markRegistryAssetLifecycle_(project, assetId, lifecycleStatus, scanRunId) {
  if (!project.registrySheetId) return;
  const sh = SpreadsheetApp.openById(project.registrySheetId).getSheetByName(V3_CONFIG.REGISTRY_TABS.ASSETS);
  const last = sh.getLastRow();
  if (last < 2) return;
  const data = sh.getRange(2,1,last-1,V3_ASSET_HEADERS.length).getValues();
  data.forEach(function(row, i) {
    if (String(row[6]) === String(assetId)) {
      sh.getRange(i+2,16).setValue(lifecycleStatus);
      sh.getRange(i+2,20).setValue(nowIso_());
      if (scanRunId) sh.getRange(i+2,22).setValue(scanRunId);
    }
  });
}

function getRegistrySummary_(project) {
  if (!project.registrySheetId) return { assets: 0, urls: 0, notPublished: 0, needsReview: 0 };
  const ss = SpreadsheetApp.openById(project.registrySheetId);
  const a = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.ASSETS);
  const u = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.URLS);
  let notPublished = 0;
  let needsReview = 0;
  if (u.getLastRow() > 1) {
    const statuses = u.getRange(2,10,u.getLastRow()-1,1).getValues();
    statuses.forEach(function(r) {
      if (r[0] === 'NOT_PUBLISHED') notPublished++;
      if (r[0] === 'NEEDS_REVIEW' || r[0] === 'INVALID') needsReview++;
    });
  }
  return { assets: Math.max(0,a.getLastRow()-1), urls: Math.max(0,u.getLastRow()-1), notPublished: notPublished, needsReview: needsReview };
}
