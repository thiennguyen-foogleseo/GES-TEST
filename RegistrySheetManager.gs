function projectConfigRowsToMapV463_(rows) {
  const out = {};
  (rows || []).forEach(function(row) {
    if (!row || !row.length) return;
    const key = safeString_(row[0]).trim();
    if (!key || key === 'Key') return;
    out[key] = row.length > 1 && row[1] != null ? safeString_(row[1]) : '';
  });
  return out;
}

function getProjectConfigMapV463_(project) {
  if (!project || !project.registrySheetId) return {};
  const ss = SpreadsheetApp.openById(project.registrySheetId);
  const sh = ss.getSheetByName(V3_CONFIG.REGISTRY_TABS.CONFIG);
  if (!sh || sh.getLastRow() < 2) return {};
  return projectConfigRowsToMapV463_(sh.getRange(2, 1, sh.getLastRow() - 1, 2).getDisplayValues());
}

function getProjectSettingsVerificationKeysV463_() {
  var keys = [
    'Project Name', 'Project Keyword', 'Project Type', 'Target Page URL',
    'Brand Name', 'Website URL', 'Branding Enabled',
    'Hotline 1', 'Hotline 2', 'Branding Email', 'Branding Address',
    'Logo Drive File ID', 'Logo Public URL',
    'CTA Drive File ID', 'CTA Public URL', 'CTA Label',
    'Google Maps URL',
    'Branding Target Slides', 'Branding Target Docs', 'Branding Target PDF',
    'Branding Target DOCX', 'Branding Target HTML',
    'Scheduled Registry Sync'
  ];
  if (typeof getExtendedGoogleAssetVerificationKeysV465_ === 'function') {
    keys = keys.concat(getExtendedGoogleAssetVerificationKeysV465_());
  } else {
    keys.push('Google Sites URL');
  }
  return keys;
}

function verifyProjectConfigMapV463_(project, actualMap) {
  project = normalizeProjectProfileV31_(project);
  const expectedMap = projectConfigRowsToMapV463_(buildProjectConfigRowsV463_(project, '__VERIFY__'));
  const keys = getProjectSettingsVerificationKeysV463_();
  const mismatches = [];
  keys.forEach(function(key) {
    const expected = safeString_(expectedMap[key] == null ? '' : expectedMap[key]).trim();
    const actual = safeString_(actualMap && actualMap[key] != null ? actualMap[key] : '').trim();
    if (expected !== actual) mismatches.push({ key: key, expected: expected, actual: actual });
  });
  return {
    success: mismatches.length === 0,
    checkedKeys: keys.length,
    mismatches: mismatches
  };
}

function verifyProjectConfigPersistenceV463_(project) {
  if (!project || !project.registrySheetId) {
    return {
      success: false,
      checkedKeys: 0,
      mismatches: [{ key: 'Registry', expected: 'CONFIGURED', actual: 'MISSING' }],
      code: 'PROJECT_CONFIG_REGISTRY_NOT_CONFIGURED'
    };
  }
  const actualMap = getProjectConfigMapV463_(project);
  const result = verifyProjectConfigMapV463_(project, actualMap);
  result.registrySheetId = project.registrySheetId;
  return result;
}

function syncProjectConfigSheet_(project) {
  if (!project || !project.registrySheetId) {
    return { success: false, skipped: true, reason: 'REGISTRY_NOT_CONFIGURED' };
  }
  project = normalizeProjectProfileV31_(project);
  const ss = SpreadsheetApp.openById(project.registrySheetId);
  const sh = ensureSheetWithHeaders_(ss, V3_CONFIG.REGISTRY_TABS.CONFIG, ['Key','Value']);
  const syncedAt = nowIso_();
  const rows = buildProjectConfigRowsV463_(project, syncedAt);
  if (sh.getLastRow() > 1) sh.getRange(2,1,sh.getLastRow()-1,2).clearContent();
  sh.getRange(2,1,rows.length,2).setValues(rows);
  var extendedAssets = null;
  try {
    if (typeof syncExtendedGoogleAssetsRegistryV465_ === 'function') extendedAssets = syncExtendedGoogleAssetsRegistryV465_(project);
  } catch (e) {
    extendedAssets = { success:false, error:safeString_(e && e.message || e) };
  }
  return {
    success: true,
    spreadsheetId: project.registrySheetId,
    rowCount: rows.length,
    syncedAt: syncedAt,
    extendedAssets: extendedAssets
  };
}

function assetSheetKey_(projectId, sourceDocId, assetType, assetId) {
  // Asset rows are keyed by the real asset ID so linking/unlinking a Source Doc never creates a duplicate row.
  return [projectId, assetType, assetId].join('|');
}

function upsertManagedAssetToRegistrySheet_(project, docFile, assetType, scanRunId) {
  const state = getAssetState_(project, docFile, assetType);
  if (!state.id) return null;
  const file = DriveApp.getFileById(state.id);
  const folder = getOutputFolderByAssetType_(project, assetType);
  return upsertInventoryAsset_(project, {
    sourceDocId: docFile.getId(),
    sourceDocName: docFile.getName(),
    assetType: assetType,
    assetId: file.getId(),
    assetName: file.getName(),
    mimeType: file.getMimeType(),
    folderId: getDirectParentId_(file),
    folderName: getDirectParentName_(file),
    url: file.getUrl(),
    sourceModified: docFile.getLastUpdated().toISOString(),
    assetModified: file.getLastUpdated().toISOString(),
    syncStatus: state.status,
    lifecycleStatus: 'KNOWN',
    resolutionMethod: state.resolutionMethod || '',
    systemAsset: false,
    lastSynced: (getAssetRegistry_(project.projectId, docFile.getId(), assetType) || {}).lastSyncedAt || '',
    lastSeenRunId: scanRunId || ''
  });
}


function upsertProjectManagedAssetToRegistrySheetV41_(project, assetType, scanRunId) {
  const state = getProjectSingletonAssetStateV41_(project, assetType);
  if (!state.id) return null;
  const file = DriveApp.getFileById(state.id);
